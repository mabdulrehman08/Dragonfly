# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# mock = deterministic rule-based agents (no API key needed); claude = real agents
DRAGONFLY_LLM=mock
DRAGONFLY_MODEL=claude-sonnet-5
# sim = tools read the simulated world; live = NASA FIRMS + Open-Meteo
DRAGONFLY_MODE=sim
FIRMS_MAP_KEY=
